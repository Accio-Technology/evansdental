---
interface Props {
    image: string;
    title: string;
}

const { image, title } = Astro.props;
---

<section
    class="about-hero"
    style={`background-image: linear-gradient(rgb(0 0 0 / 0.2), rgb(0 0 0 / 0.2)), url('${image}')`}>
    <h1>{title}</h1>
</section>

<style>
    .about-hero {
        display: flex;
        align-items: flex-end;
        height: clamp(360px, 45vw, 560px);
        padding: clamp(40px, 5vw, 80px) clamp(40px, 5vw, 80px) clamp(16px, 3vw, 52px)
            clamp(16px, 3vw, 52px);
        background-position: 47% 50%;
        background-size: cover;
    }

    .about-hero h1 {
        margin: 0;
        color: #ffffff;
        font-family: var(--font-display);
        font-size: clamp(2rem, 3.2vw, 3.25rem);
        font-weight: 700;
        line-height: 1.15;
        text-shadow: 0 2px 12px rgb(0 0 0 / 0.3);
        white-space: nowrap;
    }

    @media (max-width: 868px) {
        .about-hero {
            padding: 56px var(--container-gutter);
            background-position: 45% 50%;
        }

        .about-hero h1 {
            font-size: clamp(1.5rem, 6vw, 2rem);
            white-space: normal;
        }
    }
</style>
