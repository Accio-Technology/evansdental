---
import ServicesAccordion from '../services/ServicesAccordion.astro';
import type { ServiceAccordionItem } from '../../data/services';

interface FaqImage {
    src: string;
    alt: string;
    width: number;
    height: number;
}

interface Props {
    title: string;
    images: FaqImage[];
    items: ServiceAccordionItem[];
}

const { title, images, items } = Astro.props;
---

<section class="faq-hero" aria-labelledby="faq-title">
    <div class="content-layer">
        <div class="content-panel">
            <h1 id="faq-title">{title}</h1>
            <ServicesAccordion items={items} group="evans-faq" />
        </div>
    </div>

    <div class="photo-strip">
        {
            images.map((image, index) => (
                <figure>
                    <img
                        src={image.src}
                        alt={image.alt}
                        width={image.width}
                        height={image.height}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        fetchpriority={index === 0 ? 'high' : undefined} />
                </figure>
            ))
        }
    </div>
</section>

<style>
    .faq-hero {
        padding: clamp(64px, 7vw, 112px) 0 0;
        background: var(--brand-cream);
    }

    .content-layer {
        width: min(100% - 2rem, 920px);
        margin: 0 auto;
        padding-bottom: clamp(48px, 6vw, 96px);
    }

    .photo-strip {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        height: clamp(260px, 28vw, 420px);
        overflow: hidden;
    }

    figure {
        min-width: 0;
        min-height: 0;
        margin: 0;
        overflow: hidden;
    }

    img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    figure:nth-child(1) img {
        object-position: 50% 45%;
    }

    figure:nth-child(2) img {
        object-position: 50% 50%;
    }

    figure:nth-child(3) img {
        object-position: 50% 50%;
    }

    figure:nth-child(4) img {
        object-position: 50% 50%;
    }

    figure:nth-child(5) img {
        object-position: 50% 35%;
    }

    h1 {
        margin: 0 0 clamp(28px, 3vw, 44px);
        color: var(--brand-dark);
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 4.5vw, 4rem);
        font-weight: 400;
        line-height: 1.15;
        text-align: center;
    }

    @media (max-width: 868px) and (orientation: portrait) {
        .faq-hero {
            padding-top: 48px;
        }

        .content-layer {
            padding-bottom: 32px;
        }

        .photo-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            grid-template-rows: 140px clamp(220px, 70vw, 320px) 140px;
            gap: 0;
            height: auto;
        }

        .photo-strip figure {
            background: var(--brand-cream);
        }

        .photo-strip figure:nth-child(1) {
            order: 2;
        }

        .photo-strip figure:nth-child(2) {
            order: 4;
        }

        .photo-strip figure:nth-child(3) {
            order: 1;
        }

        .photo-strip figure:nth-child(4) {
            order: 5;
        }

        .photo-strip figure:nth-child(5) {
            order: 3;
            grid-column: span 2;
        }

        .photo-strip figure:nth-child(n) img {
            object-fit: cover;
            object-position: center;
        }

        h1 {
            margin-bottom: 24px;
            font-size: clamp(2rem, 8vw, 2.75rem);
        }
    }
</style>
