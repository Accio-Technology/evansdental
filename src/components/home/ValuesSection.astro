---
import type { FeatureItem } from '@common/components/types';

interface Props {
    title: string;
    items: FeatureItem[];
    image: string;
}

const { title, items, image } = Astro.props;
---

<section class="values" id="why">
    <div class="values-grid">
        <div class="values-media">
            <h2>{title}</h2>
            <div class="values-photo" style={`background-image: url('${image}')`} role="img" aria-label="Office photo placeholder"></div>
        </div>

        <div class="values-copy">
            {
                items.map((item) => (
                    <div class="value">
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .values {
        padding: 120px 4vw;
        background: var(--brand-cream);
    }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(48px, 6vw, 96px);
        max-width: 1400px;
        margin: 0 auto;
        align-items: start;
    }

    .values-media,
    .values-copy {
        min-width: 0;
    }

    .values-copy {
        align-self: stretch;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding-top: clamp(24px, 2.5vw, 40px);
    }

    .values-photo {
        width: 100%;
        aspect-ratio: 3 / 2;
        background-position: center;
        background-size: cover;
        border-radius: 2px;
    }

    h2 {
        margin: 0 0 32px;
        color: var(--brand-dark);
        font-family: var(--font-display);
        font-size: 2.8rem;
        font-weight: 400;
        text-align: center;
    }

    h3 {
        margin-bottom: 12px;
        color: var(--brand-dark);
        font-family: var(--font-sans);
        font-size: 1.2rem;
        font-weight: 700;
        text-align: center;
    }

    p {
        color: var(--brand-dark);
        font-size: 1rem;
        line-height: 1.8;
        text-align: center;
    }

    @media (max-width: 868px) {
        .values {
            padding: 80px 4vw;
        }

        h2 {
            margin-bottom: 24px;
            font-size: 2.2rem;
        }
    }

    @media (max-width: 868px) and (orientation: portrait) {
        .values-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .values-copy {
            display: block;
            padding-top: 0;
        }

        .value + .value {
            margin-top: 32px;
        }
    }

    @media (max-width: 868px) and (orientation: landscape) {
        .values-copy {
            row-gap: 16px;
        }
    }
</style>
