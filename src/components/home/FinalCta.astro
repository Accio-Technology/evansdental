---
interface Props {
    title: string;
    buttonLabel: string;
    href: string;
    image: string;
}

const { title, buttonLabel, href, image } = Astro.props;
---

<section
    class="final-cta"
    id="contact"
    style={`background-image: linear-gradient(rgb(0 0 0 / 0.15), rgb(0 0 0 / 0.15)), url('${image}')`}>
    <div class="final-cta-inner">
        <h1>{title}</h1>
        <a class="btn btn-pill" href={href}>{buttonLabel}</a>
    </div>
</section>

<style>
    .final-cta {
        display: grid;
        grid-template-rows: repeat(2, 1fr);
        min-height: 640px;
        justify-items: center;
        padding: 0 4vw;
        background-position: center;
        background-size: cover;
        color: var(--brand-cream);
        text-align: center;
    }

    .final-cta-inner {
        grid-row: 2;
        align-self: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: max-content;
        max-width: 100%;
    }

    h1 {
        margin-bottom: 40px;
        color: var(--brand-cream);
        font-family: var(--font-display);
        font-size: 3.2rem;
        font-weight: 400;
    }

    .final-cta :global(.btn-pill) {
        width: 66%;
        padding-top: 1.2rem;
        padding-bottom: 1.2rem;
    }

    @media (max-width: 868px) {
        .final-cta {
            min-height: 520px;
            padding: 0 4vw;
        }

        h1 {
            font-size: 2.4rem;
        }
    }
</style>
