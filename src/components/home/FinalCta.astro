---
interface Props {
    title: string;
    buttonLabel: string;
    href: string;
    image: string;
}

const { title, buttonLabel, href, image } = Astro.props;
---

<section
    class="final-cta"
    id="contact"
    style={`background-image: linear-gradient(rgb(0 0 0 / 0.15), rgb(0 0 0 / 0.15)), url('${image}')`}>
    <div class="final-cta-inner">
        <h1>{title}</h1>
        <a class="btn btn-pill" href={href}>{buttonLabel}</a>
    </div>
</section>

<style>
    .final-cta {
        display: flex;
        min-height: clamp(280px, 32vw, 460px);
        align-items: center;
        justify-content: center;
        padding: 0 4vw;
        background-position: 0% 35%;
        background-size: 105% auto;
        color: var(--brand-cream);
        text-align: center;
    }

    .final-cta-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: max-content;
        max-width: 100%;
        transform: translateY(70px);
    }

    h1 {
        color: var(--brand-cream);
        font-family: var(--font-display);
        font-size: 4.2rem;
        font-weight: 700;
    }

    .final-cta :global(.btn-pill) {
        width: 50%;
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
        margin-top: 5%;
    }

    @media (max-width: 868px) {
        h1 {
            font-size: 2.4rem;
        }
    }

    @media (max-width: 868px) and (orientation: portrait) {
        .final-cta {
            background-position: 25% 35%;
            background-size: 110% auto;
        }

        .final-cta-inner {
            transform: translateY(40px);
        }
    }
</style>
