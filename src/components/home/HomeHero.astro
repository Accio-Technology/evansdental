---
interface Props {
    title: string;
    subhead: string;
    image: string;
}

const { title, subhead, image } = Astro.props;
---

<section
    class="source-hero"
    id="top"
    style={`background-image: linear-gradient(rgb(0 0 0 / 0.2), rgb(0 0 0 / 0.2)), url('${image}')`}>
    <div class="hero-inner">
        <h1>{title}</h1>
        <p class="hero-subhead" set:html={subhead}></p>
    </div>
</section>

<style>
    .source-hero {
        display: grid;
        grid-template-rows: repeat(3, 1fr);
        min-height: 760px;
        justify-items: center;
        padding: 0 4vw;
        background-position: center;
        background-size: cover;
        color: var(--brand-cream);
        text-align: center;
    }

    .hero-inner {
        grid-row: 3;
        align-self: center;
        width: 100%;
        max-width: 1100px;
    }

    h1 {
        margin-bottom: 32px;
        color: var(--brand-cream);
        font-family: var(--font-display);
        font-size: 4rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .hero-subhead {
        color: var(--brand-cream);
        font-family: var(--font-display);
        font-size: 1.35rem;
        line-height: 1.5;
    }

    .hero-subhead :global(strong) {
        display: block;
        margin-bottom: 8px;
        font-weight: 400;
    }

    @media (max-width: 868px) {
        .source-hero {
            min-height: 620px;
            padding: 0 4vw;
        }

        h1 {
            font-size: 2.6rem;
        }

        .hero-subhead {
            font-size: 1rem;
        }
    }
</style>
