---
import type { HistorySection } from '../../data/our-history';

interface HistorySectionWithImage extends HistorySection {
    imageSrc: string;
}

interface Props {
    sections: HistorySectionWithImage[];
}

const { sections } = Astro.props;
---

<section class="history" aria-label="Our history timeline">
    <div class="history-inner">
        {
            sections.map((section, index) => (
                <article class="history-row" data-layout={index % 2 === 0 ? 'image-left' : 'text-left'}>
                    <figure class="history-photo">
                        <img
                            src={section.imageSrc}
                            alt={section.imageAlt}
                            width="1200"
                            height="1600"
                            loading="lazy"
                            decoding="async"
                        />
                    </figure>

                    <div class="history-copy">
                        {section.entries.map((entry) => (
                            <div class="history-entry">
                                <h2>{entry.year}</h2>
                                {entry.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                            </div>
                        ))}
                        {section.closingLine && <p class="closing-line">{section.closingLine}</p>}
                    </div>
                </article>
            ))
        }
    </div>
</section>

<style>
    .history {
        padding: 0 4vw clamp(72px, 8vw, 120px);
        background: var(--brand-cream);
    }

    .history-inner {
        display: grid;
        gap: clamp(56px, 7vw, 120px);
        max-width: 1200px;
        margin: 0 auto;
    }

    .history-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: stretch;
        column-gap: clamp(32px, 5vw, 88px);
    }

    .history-row[data-layout='text-left'] .history-photo {
        order: 2;
    }

    .history-row[data-layout='text-left'] .history-copy {
        order: 1;
    }

    .history-photo {
        margin: 0;
        overflow: hidden;
        background: var(--brand-cream);
    }

    .history-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
    }

    .history-copy {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 24px;
        min-height: 100%;
    }

    .history-copy h2 {
        margin: 0 0 12px;
        color: var(--brand-dark);
        font-family: var(--font-display);
        font-size: clamp(2rem, 3vw, 3rem);
        font-weight: 400;
        line-height: 1.2;
    }

    .history-copy p {
        margin: 0 0 16px;
        color: var(--brand-dark);
        font-size: 1rem;
        line-height: 1.8;
    }

    .history-copy p:last-child {
        margin-bottom: 0;
    }

    .closing-line {
        font-weight: 700;
    }

    @media (max-width: 868px) and (orientation: portrait) {
        .history {
            padding: 0 4vw 72px;
        }

        .history-inner {
            gap: 56px;
        }

        .history-row,
        .history-row[data-layout='text-left'] {
            grid-template-columns: minmax(0, 1fr);
            align-items: start;
            row-gap: 24px;
        }

        .history-row .history-photo,
        .history-row[data-layout='text-left'] .history-photo {
            order: 1;
        }

        .history-row .history-copy,
        .history-row[data-layout='text-left'] .history-copy {
            order: 2;
        }

        .history-photo img {
            height: auto;
        }

        .history-copy {
            display: block;
        }

        .history-entry + .history-entry {
            margin-top: 32px;
        }

        .closing-line {
            margin-top: 24px;
        }

        .history-copy h2 {
            font-size: 2rem;
        }
    }
</style>
