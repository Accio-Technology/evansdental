---
import { getImage } from 'astro:assets';
import aboutHeroPhoto from '../assets/images/about-hero.webp';
import jeffPhoto from '../assets/images/team-jeff.webp';
import cathyPhoto from '../assets/images/team-cathy.jpg';
import zunobiaPhoto from '../assets/images/team-zunobia.jpg';
import nilaPhoto from '../assets/images/team-nila.jpg';
import sisiPhoto from '../assets/images/team-sisi.jpg';
import AboutHero from '../components/about/AboutHero.astro';
import TeamSection from '../components/about/TeamSection.astro';
import { team, type TeamPhoto } from '../data/about';
import Page from '../layouts/Page.astro';

const bannerImage = (
    await getImage({ src: aboutHeroPhoto, width: 1600, format: 'webp', quality: 80 })
).src;

const photos: Record<TeamPhoto, string> = {
    jeff: (await getImage({ src: jeffPhoto, width: 1200, format: 'webp', quality: 80 })).src,
    cathy: (await getImage({ src: cathyPhoto, width: 800, format: 'webp', quality: 80 })).src,
    zunobia: (await getImage({ src: zunobiaPhoto, width: 800, format: 'webp', quality: 80 })).src,
    nila: (await getImage({ src: nilaPhoto, width: 800, format: 'webp', quality: 80 })).src,
    sisi: (await getImage({ src: sisiPhoto, width: 800, format: 'webp', quality: 80 })).src,
};

const members = team.map((member) => ({ ...member, image: photos[member.photo] }));
---

<Page
    title="Meet the Team"
    description="Meet the Evans Dental team. Learn about our practice and commitment to quality dental care in Chantilly, VA.">
    <AboutHero image={bannerImage} title="We believe good oral health starts at home." />
    <TeamSection {members} />
</Page>
