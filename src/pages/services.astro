---
import { getImage } from 'astro:assets';
import ServicesHero from '../components/services/ServicesHero.astro';
import Page from '../layouts/Page.astro';
import { serviceAccordionItems } from '../data/services';
import servicesHeroPhoto from '../assets/images/services-xray.jpg';
import servicesToolsPhoto from '../assets/images/services-tools.webp';

const heroImage = (
    await getImage({ src: servicesHeroPhoto, width: 1200, format: 'webp', quality: 80 })
).src;
const toolsImage = (
    await getImage({ src: servicesToolsPhoto, width: 1200, format: 'webp', quality: 80 })
).src;
---

<Page
    title="Dental Services"
    description="General, preventive, and family dentistry in Chantilly, Virginia.">
    <ServicesHero
        title="Services We Offer"
        heroImage={heroImage}
        toolsImage={toolsImage}
        items={serviceAccordionItems}
    />
</Page>
