---
import BaseLayout from '@common/components/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import latoLightUrl from '../assets/fonts/Lato-Light.ttf?url';
import lavigneDisplayRegularUrl from '../assets/fonts/Lavigne Display Regular.ttf?url';
import '../styles/theme.css';

interface Props {
    title: string;
    description?: string;
    noindex?: boolean;
    turnstile?: boolean;
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex, turnstile, jsonLd } = Astro.props;
const navLinks = site.nav ?? [];
const headerLogo = site.logo;
const footerLogo = site.images.horizontalLogo;
---

<BaseLayout
    {site}
    {title}
    {description}
    {noindex}
    {turnstile}
    {jsonLd}
    bodyClass="page"
    titleTemplate="{site} | {title}"
    header={null}
    footer={null}>
    <SiteHeader
        logo={headerLogo}
        logoAlt={site.name}
        {navLinks}
        cta={site.headerCta} />

    <main>
        <slot />
    </main>

    <SiteFooter
        businessName={site.legalName ?? site.name}
        logo={footerLogo}
        logoAlt={site.name}
        contact={site.contact}
        hours={site.hours}
        mapsUrl={site.googleMapsUrl} />

    <Fragment slot="head">
        <link rel="preload" href={latoLightUrl} as="font" type="font/ttf" crossorigin />
        <link rel="preload" href={lavigneDisplayRegularUrl} as="font" type="font/ttf" crossorigin />
    </Fragment>

    <Fragment slot="scripts">
        <script>
            import '@common/scripts/index';
        </script>
    </Fragment>
</BaseLayout>
