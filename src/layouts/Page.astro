---
import BaseLayout from '@common/components/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import '../styles/theme.css';

interface Props {
    title: string;
    description?: string;
    noindex?: boolean;
    turnstile?: boolean;
    jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex, turnstile, jsonLd } = Astro.props;
const navLinks = site.nav ?? [];
const headerLogo = site.logo;
const footerLogo = site.images.horizontalLogo;
---

<BaseLayout
    {site}
    {title}
    {description}
    {noindex}
    {turnstile}
    {jsonLd}
    bodyClass="page"
    titleTemplate="{site} | {title}"
    header={null}
    footer={null}>
    <SiteHeader
        logo={headerLogo}
        logoAlt={site.name}
        {navLinks}
        cta={site.headerCta} />

    <main>
        <slot />
    </main>

    <SiteFooter
        businessName={site.legalName ?? site.name}
        logo={footerLogo}
        logoAlt={site.name}
        contact={site.contact}
        hours={site.hours}
        mapsUrl={site.googleMapsUrl} />

    <Fragment slot="head">
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Lato:wght@300;400;700&display=swap"
            rel="stylesheet" />
    </Fragment>

    <Fragment slot="scripts">
        <script>
            import '@common/scripts/index';
        </script>
    </Fragment>
</BaseLayout>
